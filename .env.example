# ==============================================================================
# auth_api — configuração local
# Copie para `.env`. Nunca versione `.env` ou valores reais de produção.
# ==============================================================================

# Aplicação
NODE_ENV=development
APP_NAME=auth_api
APP_HOST=0.0.0.0
PORT=3000
API_PREFIX=api
API_VERSION=1
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# PostgreSQL
# Dentro do Docker Compose, use host `postgres`.
# Executando API diretamente na máquina, troque para `localhost`.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=auth_api
POSTGRES_USER=auth_api
POSTGRES_PASSWORD=change-me-local-password
DATABASE_URL=postgresql://auth_api:change-me-local-password@postgres:5432/auth_api
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Redis
# Dentro do Docker Compose, use host `redis`; fora dele, use `localhost`.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_KEY_PREFIX=auth_api:

# Autenticação
# Gere segredos diferentes, aleatórios, com no mínimo 32 bytes.
# Exemplo local: `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace-with-random-access-secret-minimum-32-bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=auth_api
JWT_AUDIENCE=auth_api-clients
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_PEPPER=replace-with-different-random-pepper-minimum-32-bytes
PASSWORD_HASH_MEMORY_COST=65536
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_PARALLELISM=1

# Cookies — habilitar quando refresh token for transportado por cookie
AUTH_COOKIE_NAME=auth_api_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

# Segurança HTTP
# Lista separada por vírgulas. Não use `*` com credenciais.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true
TRUST_PROXY=false
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Cache
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_SEARCH_TTL_SECONDS=120
CACHE_STALE_TTL_SECONDS=60

# Integrações externas
EXTERNAL_HTTP_TIMEOUT_MS=5000
EXTERNAL_HTTP_MAX_REDIRECTS=3
EXTERNAL_RETRY_ATTEMPTS=3
EXTERNAL_RETRY_BASE_DELAY_MS=200
EXTERNAL_RETRY_MAX_DELAY_MS=2000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# Provider A — substitua quando provider for escolhido
PROVIDER_A_ENABLED=false
PROVIDER_A_BASE_URL=https://api.example.com
PROVIDER_A_API_KEY=replace-with-provider-a-key

# Provider B — substitua quando provider for escolhido
PROVIDER_B_ENABLED=false
PROVIDER_B_BASE_URL=https://api.example.org
PROVIDER_B_API_KEY=replace-with-provider-b-key

# Observabilidade
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_PRETTY=true
REQUEST_ID_HEADER=x-request-id
METRICS_ENABLED=true
METRICS_PATH=metrics
TRACING_ENABLED=false
OTEL_SERVICE_NAME=auth_api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Health checks
HEALTH_PATH=health
HEALTH_DATABASE_TIMEOUT_MS=2000
HEALTH_REDIS_TIMEOUT_MS=1000
